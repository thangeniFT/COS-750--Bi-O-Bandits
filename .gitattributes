# Normalise line endings so Windows and macOS/Linux members do not produce noisy diffs.
* text=auto eol=lf

# Windows scripts need CRLF; shell scripts must stay LF or they break on macOS/Linux.
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw text eol=lf
*.sh text eol=lf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jar binary
